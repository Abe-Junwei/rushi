{
  "name": "@rushi/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:user-guide-pdf": "bash ../../scripts/build-user-guide-pdf.sh",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:asr": "PW_ASR_MOCK_WEBSERVER=1 PW_ASR_BASE_URL=http://127.0.0.1:18741 PW_ASR_MOCK_PORT=18741 playwright test --project=asr-api",
    "test:e2e:desktop": "PW_DESKTOP_WEBSERVER=1 playwright test --project=desktop-ui",
    "check:doc-links": "node ../../scripts/check-internal-doc-links.mjs",
    "tauri": "bash ../../scripts/tauri-cli.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tabler/icons-react": "^3.49.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "waveform-data": "^4.5.2",
    "wavesurfer.js": "^8.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.14",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.1",
    "@tauri-apps/cli-win32-x64-msvc": "^2.12.2",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
